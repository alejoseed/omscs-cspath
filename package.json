{
  "name": "omscs-path-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4311",
    "build": "next build",
    "start": "next start --port 4311",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/generate-seed.ts",
    "db:create": "wrangler d1 create omscs-path-builder",
    "db:migrate": "wrangler d1 migrations apply omscs-path-builder --local",
    "db:migrate:remote": "wrangler d1 migrations apply omscs-path-builder --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verify": "tsx scripts/verify-plans.ts && tsx scripts/verify-llm.ts",
    "verify:plans": "tsx scripts/verify-plans.ts",
    "verify:llm": "tsx scripts/verify-llm.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.163.0"
  }
}
