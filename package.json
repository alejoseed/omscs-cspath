{
  "name": "omscs-path-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/generate-seed.ts",
    "db:create": "wrangler d1 create omscs-path-builder",
    "db:migrate": "wrangler d1 migrations apply omscs-path-builder --local",
    "db:migrate:remote": "wrangler d1 migrations apply omscs-path-builder --remote",
    "cf-typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verify": "tsx scripts/verify-plans.ts && tsx scripts/verify-llm.ts",
    "verify:plans": "tsx scripts/verify-plans.ts",
    "verify:llm": "tsx scripts/verify-llm.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "1.94.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "wrangler": "^4.163.0"
  }
}
