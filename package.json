{
  "name": "omscs-path-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4311",
    "build": "next build",
    "start": "next start --port 4311",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:reset": "rm -rf data",
    "db:seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify-plans.ts && tsx scripts/verify-llm.ts",
    "verify:plans": "tsx scripts/verify-plans.ts",
    "verify:llm": "tsx scripts/verify-llm.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
