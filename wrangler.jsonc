{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omscs-path-builder",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omscs-path-builder",
      "database_id": "18781f77-640d-4dc6-97b6-fc72a3e33382"
    }
  ],
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-chat"
  },
  "routes": [
    {
      "pattern": "cspath.alejoseed.com",
      "custom_domain": true
    }
  ]
}
