# DeepSeek is the only LLM provider this app supports.
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown)
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: where the SQLite file lives (defaults to ./data/omscs.db)
# OMSCS_DB_PATH=./data/omscs.db
