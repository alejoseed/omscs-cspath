# Visitors bring their own DeepSeek key in the app, so the server needs none.
# Get one at https://platform.deepseek.com/api_keys

# Optional server overrides (defaults shown)
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# PLAN_RATE_LIMIT=15
# PLAN_RATE_WINDOW_MS=60000
